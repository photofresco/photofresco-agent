  "components": {
    "schemas": {
      "AccessRequest": {
        "type": "object",
        "properties": {
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read",
                "edit",
                "export",
                "external-write",
                "spend"
              ]
            },
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true
          },
          "budget_credits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "capabilities"
        ],
        "additionalProperties": false
      },
      "ConnectRequest": {
        "type": "object",
        "properties": {
          "protocol_version": {
            "type": "string"
          },
          "client": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "document": {
            "type": "string",
            "maxLength": 64
          },
          "access": {
            "$ref": "#/components/schemas/AccessRequest"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 180000
          }
        },
        "required": [
          "protocol_version"
        ],
        "additionalProperties": false
      },
      "ExecuteRequest": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "params": {
            "type": "object"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "op",
          "request_id"
        ],
        "additionalProperties": false
      },
      "OperationOutcome": {
        "type": "object",
        "required": [
          "ok",
          "status",
          "request_id"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed",
              "canceled",
              "rejected",
              "unknown"
            ]
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "document_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "result": {},
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "Artifact": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "data_base64": {
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "byte_length",
          "sha256",
          "data_base64"
        ],
        "additionalProperties": false
      },
      "Operation": {
        "type": "object",
        "required": [
          "name",
          "tool_name",
          "input_schema",
          "effects",
          "capabilities",
          "completion"
        ],
        "properties": {
          "name": {
            "type": "string"
