  "methods": [
    {
      "name": "session.connect",
      "summary": "Open the connector window and ask the user to pair; access is a request, never a grant.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "protocol_version",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "client",
          "required": false,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          }
        },
        {
          "name": "document",
          "required": false,
          "schema": {
            "type": "string",
            "maxLength": 64
          }
        },
        {
          "name": "access",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/AccessRequest"
          }
        },
        {
          "name": "timeout_ms",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 180000
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/not_connected"
        },
        {
          "$ref": "#/components/errors/denied"
        },
        {
          "$ref": "#/components/errors/validation_failed"
        },
        {
          "$ref": "#/components/errors/stale_revision"
        },
        {
          "$ref": "#/components/errors/canceled"
